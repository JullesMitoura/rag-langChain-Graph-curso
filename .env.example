# Chat: azure (padrão do curso) ou groq. O curso usa o Azure OpenAI para chat e embeddings.
LLM_PROVIDER=azure

# Azure OpenAI: chat e embeddings
AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com/
AZURE_OPENAI_KEY=sua-chave
AZURE_OPENAI_LLM=gpt-5.4-mini                    # nome do deployment de chat
AZURE_OPENAI_EMBEDDINGS=text-embedding-3-large   # nome do deployment de embeddings
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# LLM_TEMPERATURE=0                              # vazio = temperatura padrão do modelo

# Embeddings: azure (padrão) ou openai. O índice só funciona com o modelo que o criou.
EMBEDDINGS_PROVIDER=azure
# OPENAI_API_KEY=sua-chave                       # EMBEDDINGS_PROVIDER=openai
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large

# Groq (alternativa para o chat, LLM_PROVIDER=groq; plano gratuito com limite diário de tokens)
# GROQ_API_KEY=sua-chave
# GROQ_MODEL=openai/gpt-oss-120b

# Opcionais (valores padrão)
# EMBEDDINGS_DIMENSIONS=               # vazio = dimensão nativa do modelo
# CHUNK_SIZE=1000                      # caracteres por trecho
# CHUNK_OVERLAP=150
# RETRIEVAL_K=4                        # trechos entregues ao modelo
# FETCH_K=12                           # candidatos de cada busca antes da fusão e da reordenação
# MAX_REWRITES=2                       # tentativas de reescrever a consulta no RAG corretivo
# LOG_LEVEL=INFO
